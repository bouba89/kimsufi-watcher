# Copiez ce fichier en .env puis modifiez les valeurs. Ne commitez jamais .env.
KW_USER=admin
KW_PASS='changez-moi'
# Adresse d'écoute : 127.0.0.1 (machine locale, à privilégier derrière un reverse proxy)
# ou 0.0.0.0 (tout le réseau)
KW_BIND=127.0.0.1
# Port publié sur la machine (optionnel)
KW_PORT=8080
